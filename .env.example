# Copy to .env and set BOT_PRIVATE_KEY (and BUNDLER_WALLET_KEYS if needed):
#   copy .env.example .env

# --- Arc testnet (default) ---------------------------------------------------
CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
EXPLORER_URL=https://testnet.arcscan.app

# OkeiFactory on Arc testnet — same as okei NEXT_PUBLIC_FACTORY_ADDRESS
FACTORY_ADDRESS=0x05b6b26cd29a951a2ca47001ac8fc04ec471a412

# Dev / creator wallet: private key (0x + 64 hex). Pays createToken + dev buy.
# This is NOT listed in BUNDLER_WALLET_KEYS. Fund this address with testnet USDC.
BOT_PRIVATE_KEY=

# Optional. Only for JSON field "bundleBuys" (one tx, one payer via contract).
# Deploy: cd bundler && forge build && npm run deploy:atomic
# Then paste the ONE contract address printed (OkeiAtomicLaunch), e.g. 0xabc...
# Do NOT put wallet addresses here. Order does not apply — single address only.
# Leave empty for normal launch or for "walletBuys" (same-block multi-wallet).
ATOMIC_LAUNCH_ADDRESS=

# Optional. Only for JSON field "walletBuys" (N txs, each wallet pays its own buy).
# Comma-separated PRIVATE KEYS (same order as keyIndex in the JSON):
#   walletBuys[0] -> keyIndex 0 (first key here)
#   walletBuys[1] -> keyIndex 1 (second key here)
# Dev wallet stays BOT_PRIVATE_KEY above — do not duplicate it here unless it also buys.
# Example: BUNDLER_WALLET_KEYS=0xabc...,0xdef...  (0x prefix optional)
BUNDLER_WALLET_KEYS=

# Optional: directory for launch monitor JSON reports (default data/monitor)
# BUNDLER_MONITOR_DIR=

# Delayed wallet buys (blocksAfterCreate >= 1): default = time, not chain block number
# BUNDLER_BUNDLE_TIMING=time
# BUNDLER_BLOCK_TIME_MS=250
# For cheap/slow RPC, try 500–1500 so delay ≈ one real block after create confirms
# BUNDLER_RECEIPT_POLL_MS=100
# Block-number targeting (needs fast RPC): BUNDLER_BUNDLE_TIMING=block
# BUNDLER_BLOCK_POLL_MS=50

# Links in logs/API after launch (token page: {OKEI_SITE_URL}/token/{curve})
OKEI_SITE_URL=https://testnet.okei.fun

# Logo upload for logoFile in launch JSON (same as okei Pinata proxy). Optional if OKEI_SITE_URL /api/upload works.
# PINATA_JWT=
# If testnet.okei.fun shows symbol initials instead of your logo, store a direct https gateway URL on chain:
# BUNDLER_LOGO_IMAGE_HTTPS=1
# BUNDLER_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- HTTP bot ----------------------------------------------------------------
# Local port for POST /launch (default 8787)
BUNDLER_PORT=8787

# Optional shared secret YOU choose (not from okei.fun). If set, clients must send:
#   Authorization: Bearer <value>   OR   x-bundler-key: <value>
# Leave empty for local testing (no auth).
BUNDLER_API_KEY=

# --- Arc mainnet (optional) --------------------------------------------------
# CHAIN_ID=5042
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# EXPLORER_URL=https://arcscan.app
# FACTORY_ADDRESS=
# OKEI_SITE_URL=https://okei.fun
